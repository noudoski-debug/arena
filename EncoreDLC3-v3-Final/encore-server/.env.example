# ===========================================================================
# EncoreDLC v3 - Сервер ключей
# ===========================================================================
# Скопируй этот файл в .env и заполни своими значениями.
# На Render.com / Railway / любом хосте эти переменные задаются
# через Environment Variables в дашборде.

# ----- Telegram -----
BOT_TOKEN=0000000000:AAHexampleTokenFromBothfather              # Токен от @BotFather
ADMIN_IDS=123456789,987654321                                    # Твои Telegram user_id через запятую
PUBLIC_CHANNEL=@encoredlc                                        # Канал для обязательной подписки (оставь пустым = не проверять)
SUPPORT_USERNAME=@your_username                                   # Юзернейм саппорта (без @ можно и с @)

# ----- CryptoBot (приём платежей в TON/USDT/BTC/ETH/LTC/BUSD) -----
CRYPTOBOT_TOKEN=1234:AAA_example_cryptobot_token                  # Токен из @CryptoBot (Crypto Pay)
# Создавай приложение: @CryptoBot -> Crypto Pay -> Create App

# ----- Цены (в USD через CryptoBot он сам сконвертирует) -----
PRICE_7D=3
PRICE_30D=9
PRICE_LIFETIME=29

# ----- Веб -----
PORT=3000
ADMIN_USER=admin
ADMIN_PASS=encoreadmin                                            # Поменяй на свой!
PUBLIC_BASE_URL=https://encore-dlc.onrender.com                   # Публичный URL бэкенда (для вебхуков ТГ и ссылок)

# ----- База данных -----
# На Render.free файловая система эфемерная — используй Postgres (URL ниже).
# Если оставишь пустым — будет локальный SQLite ./data/encore.db
DATABASE_URL=
